{
  "name": "bot-mineflayer",
  "version": "0.9.0",
  "description": "Mineflayer bot that speaks the mc-agents bot protocol",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bot-mineflayer": "dist/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node src/main.ts",
    "rpc": "node scripts/rpc-cli.ts",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "check:version": "node scripts/check-version.ts",
    "sync:catalog": "node scripts/sync-catalog.ts"
  },
  "dependencies": {
    "minecraft-data": "^3.116.0",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-block": "^1.23.0",
    "prismarine-entity": "^2.6.0",
    "prismarine-item": "^1.18.0",
    "prismarine-nbt": "^2.8.0",
    "prismarine-recipe": "^1.5.0",
    "prismarine-windows": "^2.10.0",
    "vec3": "^0.1.10",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
